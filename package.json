{
    "name": "portfolio",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/prerender-seo.mjs",
        "preview": "vite preview",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "check": "biome check .",
        "fix": "biome check --write .",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:fast": "playwright test --project=chromium",
        "test:e2e:headed": "playwright test --project=chromium --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:e2e:open": "start \"\" playwright-report\\index.html"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@phosphor-icons/react": "^2.1.10",
        "@react-pdf/renderer": "^4.9.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.104.3",
        "@tanstack/react-query-devtools": "^5.104.3",
        "@tanstack/react-router": "^1.170.45",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "mermaid": "^12.2.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-github-blockquote-alert": "^2.1.0",
        "shadcn": "^4.22.0",
        "shiki": "^4.5.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.64.1",
        "@tanstack/router-plugin": "^1.168.47",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/ui": "^4.1.12",
        "esbuild": "^0.28.2",
        "jsdom": "^29.1.1",
        "typescript": "~6.0.2",
        "vite": "^8.3.4",
        "vitest": "^4.1.12"
    }
}
